{
  "name": "forkcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "wasm:build": "wasm-pack build crates/recipe-domain --target web --out-dir pkg --release --no-pack --no-opt",
    "dev": "npm run wasm:build && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run wasm:build && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write src tests *.ts package.json tsconfig.json .prettierrc.json index.html README.md .github/workflows",
    "check:format": "prettier --check src tests *.ts package.json tsconfig.json .prettierrc.json index.html README.md .github/workflows",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "wasm-pack": "0.15.0"
  }
}
