{
  "name": "forkcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "wasm:build": "wasm-pack build crates/recipe-domain --target web --out-dir pkg --release --no-pack --no-opt",
    "dev": "npm run wasm:build && vite --host 127.0.0.1",
    "backend:dev": "cargo run -p forkcast-backend",
    "backend:build": "cargo build --release -p forkcast-backend",
    "typecheck": "tsc --noEmit",
    "build": "npm run wasm:build && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write src tests *.ts package.json tsconfig.json .prettierrc.json index.html README.md .github/workflows",
    "check:format": "prettier --check src tests *.ts package.json tsconfig.json .prettierrc.json index.html README.md .github/workflows",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "server:build": "npm run build && cargo build --release -p forkcast-backend",
    "test:prepare": "npm run build && cargo build -p forkcast-desktop -p forkcast-backend --features forkcast-desktop/custom-protocol",
    "android:build": "tauri android build --debug --apk"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "pdfmake": "0.3.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "26.6.5",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pdfjs-dist": "5.4.296",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wasm-pack": "0.15.0"
  }
}
