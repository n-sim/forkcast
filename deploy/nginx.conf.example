# nginx in front of the Forkcast server (TLS certificates managed by you).
server {
    listen 443 ssl http2;
    server_name forkcast.example.com;
    ssl_certificate     /etc/letsencrypt/live/forkcast.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forkcast.example.com/privkey.pem;
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /api/changes is a long-lived event stream.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
